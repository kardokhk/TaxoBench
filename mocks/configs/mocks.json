{
  "mockrobiota": {
    "mockrobiota-16S": {
      "description": "Concatenated Mockrobiota 16S mocks",
      "input_seqs": "mockrobiota-16S_seqs.fasta",
      "input_taxa": "mockrobiota-16S_taxa.txt",
      "regions_v": [
        "V4",
        "V3-V4",
        "V5-V7",
        "V1-V9"
      ],
      "rrn_counterpart": null,
      "note": "Mockrobiota does not have a full-rRNA-operon counterpart; RRN evaluation uses the GTDB-derived gtdb_* mocks below."
    }
  },
  "extra_mocks": {
    "mbarc26": {
      "description": "MBARC-26 mock community (Singer 2016 Sci. Data)",
      "input_seqs": "mbarc26_seqs.fasta",
      "input_taxa": "mbarc26_taxa.txt",
      "regions_v": [
        "V4",
        "V3-V4",
        "V5-V7",
        "V1-V9"
      ],
      "rrn_counterpart": null,
      "source": "NCBI RefSeq NR_ 16S records, fetched 2026-05-10 by mocks/scripts/01b_prepare_extra_mocks.py",
      "truth_kind": "uneven_4_orders",
      "note": "23 bacteria + 3 archaea spanning 10 phyla. Reference 16S is one representative full-length NR_ record per species (no rrn-copy multiplicity). Singer reports DNA-mass abundance spanning 4 orders of magnitude; for taxobench's Jaccard / detection-rate metrics this is fine, but L1/L2 abundance error is not meaningful here (truth is per-species, not per-rep_seq)."
    },
    "gutmock": {
      "description": "Gut mock community",
