        "parent_gates": {
            "domain": 0.5,
            "phylum": 0.5,
            "class": 0.5,
            "order": 0.5,
            "family": 0.5,
            "genus": 0.5
        },
        "scoring_rules": "v1"
    },
    "method_parameters_combinations": {
        "taxonova": {
            "confidence_threshold": [
                0.7
            ]
        },
        "vsearch": {
            "p-maxaccepts": [
                10
            ],
            "p-perc-identity": [
                0.8
            ],
            "p-min-consensus": [
                0.51
            ]
        },
        "blast": {
            "p-maxaccepts": [
                10
            ],
            "p-perc-identity": [
                0.8
            ],
            "p-min-consensus": [
                0.51
            ]
        },
        "naive-bayes": {
            "p-confidence": [
                0.7
            ]
        },
        "idtaxa": {
            "p-confidence": [
                60
            ]
        },
        "spingo": {
