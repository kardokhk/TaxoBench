                "md5": "a40d3c29f78cf4d32dac22b9d3a4a6bd",
                "sha256": "0a4ad6d18d1d39e866d3abfdba53444e532029c7f53fcdfee9eb54adec46a494"
            },
            "V5-V7": {
                "path": "V5-V7/taxonova/gg2_v5v7_mrgroups_model.pt",
