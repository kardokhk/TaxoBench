{
    "_doc": "Configuration of the published Taxonova runs (Kakabra et al., PLOS Comput Biol, doi:10.1371/journal.pcbi.1014912). Taxonova 1.0.0 with the v1.0.0 checkpoints, a flat 0.5 gate at every rank above species and 0.7 at species. Score these outputs with 04_evaluate.py --rules v1 and the v1 truth (README, 'Reproducing the paper'). The other classifiers are configured as in classifiers_default.json.",
    "classifiers": [
        "taxonova",
        "vsearch",
        "blast",
        "naive-bayes",
        "idtaxa",
        "spingo",
        "kraken2",
        "mapseq"
    ],
    "method_conda_envs": {
        "taxonova": "taxonova_paper",
        "vsearch": "qiime2",
        "blast": "qiime2",
        "naive-bayes": "qiime2",
        "idtaxa": "qiime2",
        "kraken2": "qiime2",
        "mapseq": "qiime2",
        "spingo": {
            "spingo_env": "spingo",
            "processing_env": "qiime2"
        }
    },
    "taxonova": {
        "requirement": "taxonova @ git+https://github.com/kardokhk/taxonova@v1.0.0",
        "cli": "classification",
        "models": {
